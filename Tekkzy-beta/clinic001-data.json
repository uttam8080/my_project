            "title": {
              "line1": "Technology We Use",
              "line2": ""
            },
            "items": [
              {
                "id": "technology-wavefront-guided-lasik",
                "title": "Wavefront-Guided LASIK System",
                "description": "Our state-of-the-art laser platform provides unparalleled precision, mapping over 1,200 unique points on your cornea to create a truly personalized treatment. This technology allows us to correct not just standard refractive errors, but also higher-order aberrations for superior visual quality and night vision.",
                "media": {
                  "type": "image",
                  "image": {
                    "src": "https://products.tekkzy.com/clinic001/images/tech1.png",
                    "alt": "Wavefront-Guided LASIK System",
                    "fit": "cover",
                    "focalPoint": {
                      "x": 50,
                      "y": 50
                    }
                  },
                  "video": null
                },
                "reverse": false
              },
              {
                "id": "technology-optical-coherence-tomography",
                "title": "Optical Coherence Tomography (OCT)",
                "description": "This revolutionary imaging technology provides cross-sectional views of the retina with microscopic detail, allowing early detection of conditions like macular degeneration and glaucoma years before symptoms appear. Our OCT system captures images 10 times faster than traditional methods, ensuring accuracy and comfort.",
                "media": {
                  "type": "image",
                  "image": {
                    "src": "https://products.tekkzy.com/clinic001/images/tech2.png",
                    "alt": "Optical Coherence Tomography (OCT)",
                    "fit": "cover",
                    "focalPoint": {
                      "x": 50,
                      "y": 50
                    }
                  },
                  "video": null
                },
                "reverse": true
              },
              {
                "id": "technology-femtosecond-laser-cataract-surgery",
                "title": "Femtosecond Laser Cataract Surgery",
                "description": "We utilize the most advanced bladeless cataract removal technology available. This computer-guided laser performs the most delicate steps of cataract surgery with extraordinary precision, resulting in faster healing, better visual outcomes, and reduced risk of complications compared to traditional methods.",
                "media": {
                  "type": "image",
                  "image": {
                    "src": "https://products.tekkzy.com/clinic001/images/tech3.png",
