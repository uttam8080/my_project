                "price": "$35.00",
                "iconType": "face"
              },
              {
                "id": "service-hot-towel-shave",
                "title": "HOT TOWEL SHAVE",
                "description": "A luxurious traditional straight razor shave with premium oils and steam.",
                "price": "$55.00",
                "iconType": "towel"
              },
              {
                "id": "service-royal-suite",
                "title": "THE ROYAL SUITE",
