          "enabled": true,
          "content": {
            "sectionLabel": "TESTIMONIALS",
            "sectionTitle": "WHAT OUR\nCLIENTS SAY",
            "sectionDescription": "Join the community of gentlemen who trust us with their image. Quality is our only standard.",
            "items": [
              {
                "id": "testimonial-marcus-sterling",
                "name": "MARCUS STERLING",
                "role": "ENTREPRENEUR",
                "avatar": {
                  "src": "/testimonials/avatar-marcus.svg",
                  "alt": "MARCUS STERLING"
                },
                "text": "Best cut I've had in years. The attention to detail is unmatched. It's not just a haircut, it's an experience."
              },
              {
                "id": "testimonial-james-dawson",
                "name": "JAMES DAWSON",
                "role": "ARCHITECT",
                "avatar": {
                  "src": "/testimonials/avatar-james.svg",
                  "alt": "JAMES DAWSON"
                },
                "text": "The hot towel shave is legendary. I've been coming here for 3 years and they never miss a beat. True pros."
              },
              {
                "id": "testimonial-leo-bennett",
                "name": "LEO BENNETT",
                "role": "DESIGNER",
                "avatar": {
                  "src": "/testimonials/avatar-marcus.svg",
                  "alt": "LEO BENNETT"
                },
                "text": "From consultation to finish, every detail felt premium. The team understands style and delivers consistently."
              },
              {
                "id": "testimonial-ethan-clarke",
                "name": "ETHAN CLARKE",
                "role": "CONSULTANT",
                "avatar": {
                  "src": "/testimonials/avatar-james.svg",
                  "alt": "ETHAN CLARKE"
                },
                "text": "I travel across town just for this place. Clean cuts, sharp beard work, and a level of care that stands out."
              }
            ]
          },
          "settings": {}
        },
