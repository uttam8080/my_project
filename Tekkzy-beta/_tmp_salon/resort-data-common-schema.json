          "content": {
            "eyebrow": "F-A-Q",
            "title": "F-A-Q",
            "subtitle": "Frequently Asked Questions About Tekkzy Resort",
            "description": "Everything you need to know about Tekkzy Resort",
            "items": [
              {
                "id": "faq-what-is-tekkzy-resort",
                "sourceId": 1,
                "question": "What is Tekkzy Resort?",
                "answer": "Tekkzy Resort is a luxury boutique hotel that combines contemporary art, architectural excellence, and personalized service. We offer an exclusive collection of 42 suites, each designed as a masterpiece, with rotating art exhibitions and curated cultural experiences."
              },
              {
                "id": "faq-what-is-our-mission",
                "sourceId": 2,
                "question": "What is our mission?",
                "answer": "Our mission is to create memorable experiences where contemporary art meets architectural brilliance. We believe every guest deserves personalized attention and exclusive access to the city's cultural treasures."
              },
              {
                "id": "faq-hidden-charges",
                "sourceId": 3,
                "question": "Do I have to pay any hidden charges?",
                "answer": "No, we believe in complete transparency. All pricing is clearly listed upfront with no hidden charges. What you see is what you pay. Any additional services are optional and clearly communicated."
              },
              {
                "id": "faq-how-can-i-reach",
                "sourceId": 4,
                "question": "How can I Reach?",
                "answer": "You can reach us via phone at +1-888-TKZY-RST, email us, or visit our website for more information. Our concierge team is available 24/7 to assist with reservations and inquiries."
              },
              {
                "id": "faq-weddings-events",
                "sourceId": 5,
                "question": "Can I book For Wedding And Events?",
                "answer": "Absolutely! Tekkzy Resort is perfect for weddings, corporate events, and special occasions. We offer tailored packages and event planning services. Contact our events team to discuss your requirements."
              },
              {
                "id": "faq-book-a-stay",
                "sourceId": 6,
                "question": "How can I Book A Stay Here?",
                "answer": "You can book directly through our website, call our reservations team, or use our mobile app. We also offer special packages and early-bird discounts for advance bookings."
              }
            ]
          },
          "settings": {
